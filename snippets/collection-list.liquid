<ul class="space-y-6 md:space-y-12">
  {% for collection in collections %}
    {% unless collection.handle == 'home-page' %}
    <li>
      {% render 'collection-link', href: collection.url, title: collection.title %}
    </li>
    {% endunless %}
  {% endfor %}
  <li>
    {% render 'collection-link', href: routes.all_products_collection_url, title: 'View All', %}
  </li>
</ul>
