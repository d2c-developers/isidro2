{% if collection and collection.products_count > 0 %}
  <div class="w-full grid grid-cols-2 md:grid-cols-4 gap-6">
    {% for product in collection.products %}
      <a href="{{ product.url }}" class="group omit-effect aspect-[4/5] overflow-hidden bg-amber-100/10 relative">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="group-hover:scale-110 group-hover:-rotate-1 transition-transform duration-500 w-full h-full object-cover absolute inset-0" loading="lazy" width="600" height="600">
        {% endif %}
      </a>
    {% endfor %}
  </div>
{% else %}
  <p>No products found in the collection.</p>
{% endif %}
