{% assign home_collection = collections['home-page'] %}
{% if section.settings.home_collection != blank %}
  {% assign home_collection = collections[section.settings.home_collection.handle] %}
{% endif %}

<div class="space-y-6">
  {% render 'page-description', description: section.settings.home_page_text %}
  {% render 'product-grid', collection: home_collection %}
  {% render 'cta-callout' %}
</div>


{% schema %}
{
  "name": "Home Page",
  "settings": [
    {
      "type": "richtext",
      "id": "home_page_text",
      "label": "Home Page Text",
      "default": "<p>Isidro Escasany is an artist, illustrator, and musician from Buenos Aires, Argentina specializing in abstract art and illustratrated drafts. He touches on themes of nature, life, and the human experience.</p>"
    },
    {
      "type": "collection",
      "id": "home_collection",
      "label": "Home Collection"
    }
  ],
  "presets": [
    {
      "name": "Home Page"
    }
  ]
}
{% endschema %}
