{% assign page_title = "Cart (" | append: cart.item_count | append: ")" %}
<div class="space-y-6">
  <div class="flex justify-between items-start gap-2">
    {% render 'page-description', title: page_title %}
    <div>
      <a href="{{ routes.collections_url }}" class="group inline-flex items-center">
        Continue shopping<span class="arrow-icon" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  {% if cart.item_count > 0 %}
    <div id="cart-items" class="space-y-6 border-t border-white/10 pt-6">
      <div class="space-y-6">
        {% for item in cart.items %}
          <div class="cart-item grid grid-cols-1 md:grid-cols-2 gap-4 items-start border-b border-white/10 pb-6" data-item-key="{{ item.key }}">
            <div class="flex items-start gap-4">
              <a href="{{ item.url }}" class="omit-effect aspect-[4/5] bg-amber-100/10 overflow-hidden relative w-full max-w-40">
                {% if item.image %}
                  <div class="absolute inset-0 h-full w-full bg-amber-100/10 overflow-hidden">
                    {{ item.image | image_url: width: 300 | image_tag: widths: '150,300', sizes: '150px', class: 'w-full h-full object-cover absolute inset-0' }}
                  </div>
                {% else %}
                  <div class=" absolute inset-0 h-full w-full bg-amber-100/10">
                    <span class="text-white/40">No image</span>
                  </div>
                {% endif %}
              </a>
              <div class="space-y-2">
                <h3 class="text-lg">
                  <a href="{{ item.url }}" class="hover:underline">Title: {{ item.product.title }}</a>
                </h3>
                
                {% unless item.product.has_only_default_variant %}
                  <div class="text-sm text-white/60">
                    {% for option in item.options_with_values %}
                      {{ option.name }}: {{ option.value }}
                      {% unless forloop.last %} / {% endunless %}
                    {% endfor %}
                  </div>
                {% endunless %}
  
                {% if item.original_price != item.final_price %}
                  <div class="text-sm">
                    <span class="line-through opacity-60 mr-2">{{ item.original_price | money }}</span>
                    <span>{{ item.final_price | money }}</span>
                  </div>
                {% else %}
                  <div>{{ item.final_price | money }}</div>
                {% endif %}
              </div>
            </div>

            <div class="flex items-center justify-between md:justify-end gap-4">
              <div class="flex items-center gap-2">
                <label for="quantity-{{ forloop.index }}" class="sr-only">Quantity</label>
                <input
                  type="number"
                  id="quantity-{{ forloop.index }}"
                  data-item-key="{{ item.key }}"
                  value="{{ item.quantity }}"
                  min="0"
                  class="quantity-input w-16 border border-white/10 px-2 py-1 bg-transparent rounded text-center"
                  inputmode="numeric"
                  pattern="[0-9]*"
                >
              </div>
              
              <button
                type="button"
                data-item-key="{{ item.key }}"
                class="remove-item text-sm text-white/60 hover:text-white underline cursor-pointer"
                aria-label="Remove {{ item.product.title }}"
              >
                Remove
              </button>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="flex justify-end items-center">
        <div class="text-right space-y-2">
          <div class="text-lg">
            <span class="text-white/60">Subtotal:</span>
            <span class="ml-2" id="cart-subtotal">{{ cart.total_price | money }}</span>
          </div>
          {% if cart.total_discount > 0 %}
            <div class="text-sm text-green-400">
              You saved {{ cart.total_discount | money }}!
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6">
      <div class="flex flex-col md:flex-row gap-4 justify-between items-center">
        <div></div>
        <div class="flex flex-col gap-4 w-full md:w-auto">
          <a
            href="/checkout"
            class="omit-effect text-center px-6 py-3 bg-white text-black hover:bg-white/90 transition-colors rounded font-medium cursor-pointer"
          >
            Checkout
            <span class="arrow-icon" aria-hidden="true">→</span>
          </a>
          <div class="text-sm text-white/60">
            {% if cart.requires_shipping %}
              Taxes and shipping calculated at checkout
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% else %}
    <div class="space-y-6 py-12">
      <h1>Your cart is empty</h1>
      <p class="text-white/60">Looks like you haven't added anything to your cart yet.</p>
      <a
        href="{{ routes.collections_url }}"
        class="group inline-flex items-center px-6 py-3 bg-white text-black hover:bg-white/90 transition-colors rounded font-medium"
      >
        Start shopping<span class="arrow-icon" aria-hidden="true">→</span>
      </a>
    </div>
  {% endif %}

</div>

<div class="mt-64"></div>
{% render 'cta-callout' %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.quantity-input').forEach(function(input) {
    input.addEventListener('change', function() {
      const itemKey = this.dataset.itemKey;
      const quantity = parseInt(this.value);
      
      if (quantity < 0) {
        this.value = 0;
        return;
      }
      
      updateCartItem(itemKey, quantity);
    });
  });

  document.querySelectorAll('.remove-item').forEach(function(button) {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const itemKey = this.dataset.itemKey;
      removeCartItem(itemKey);
    });
  });

  function updateCartItem(itemKey, quantity) {
    fetch('/cart/update.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({
        updates: {
          [itemKey]: quantity
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      reloadCartSection();
    })
    .catch(error => {
      console.error('Error updating cart:', error);
      window.location.reload();
    });
  }

  function removeCartItem(itemKey) {
    fetch('/cart/update.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({
        updates: {
          [itemKey]: 0
        }
      })
    })
    .then(response => response.json())
    .then(data => {
      reloadCartSection();
    })
    .catch(error => {
      console.error('Error removing item:', error);
      window.location.reload();
    });
  }

  function reloadCartSection() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        if (cart.item_count === 0) {
          window.location.reload();
        } else {
          fetch(window.location.pathname)
            .then(response => response.text())
            .then(html => {
              const parser = new DOMParser();
              const doc = parser.parseFromString(html, 'text/html');
              const newCartSection = doc.querySelector('#cart-items');
              const currentCartSection = document.querySelector('#cart-items');
              
              if (newCartSection && currentCartSection) {
                currentCartSection.innerHTML = newCartSection.innerHTML;
                reinitializeEventListeners();
              }
            })
            .catch(error => {
              console.error('Error reloading cart:', error);
              window.location.reload();
            });
        }
      })
      .catch(error => {
        console.error('Error fetching cart:', error);
        window.location.reload();
      });
  }

  function reinitializeEventListeners() {
    document.querySelectorAll('.quantity-input').forEach(function(input) {
      input.addEventListener('change', function() {
        const itemKey = this.dataset.itemKey;
        const quantity = parseInt(this.value);
        
        if (quantity < 0) {
          this.value = 0;
          return;
        }
        
        updateCartItem(itemKey, quantity);
      });
    });

    document.querySelectorAll('.remove-item').forEach(function(button) {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const itemKey = this.dataset.itemKey;
        removeCartItem(itemKey);
      });
    });
  }
});
</script>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
