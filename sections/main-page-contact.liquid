<div class="space-y-6">
  <div class="max-w-2xl">
    {% form 'contact', class: 'space-y-4' %}
      {% if form.posted_successfully? %}
        <div class="p-4 bg-green-500/20 border border-green-500/30 rounded text-green-400">
          Thank you for your message. We'll get back to you soon!
        </div>
      {% endif %}
      {% if form.errors %}
        <div class="p-4 bg-red-500/20 border border-red-500/30 rounded text-red-400">
          <h3 class="font-semibold mb-2">Please correct the following errors:</h3>
          <ul class="list-disc list-inside space-y-1">
            {% for field in form.errors %}
              <li>{{ field | capitalize }}: {{ form.errors[field] }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% render 'page-description',
        title: "Contact " | append: shop.name,
        description: page.content
      %}

      <div class="space-y-2">
        <label for="ContactFormFirstName" class="block">First Name *</label>
        <input 
          id="ContactFormFirstName"
          type="text"
          name="contact[first_name]"
          placeholder="Enter your first name"
          value="{{ form.first_name }}"
          required
          class="w-full border border-white/10 p-3 bg-transparent rounded text-lg focus:border-white/30 focus:outline-none"
        >
      </div>

      <div class="space-y-2">
        <label for="ContactFormEmail" class="block">Email *</label>
        <input 
          id="ContactFormEmail"
          type="email"
          name="contact[email]"
          placeholder="Enter your email"
          value="{{ form.email }}"
          required
          class="w-full border border-white/10 p-3 bg-transparent rounded text-lg focus:border-white/30 focus:outline-none"
        >
      </div>

      <div class="space-y-2">
        <label for="ContactFormMessage" class="block">Message *</label>
        <textarea 
          id="ContactFormMessage" 
          name="contact[body]" 
          rows="6"
          placeholder="Enter your message"
          required
          class="w-full border border-white/10 p-3 bg-transparent rounded text-lg focus:border-white/30 focus:outline-none resize-vertical"
        >{{ form.body }}</textarea>
      </div>

      <button
        type="submit"
        class="w-full px-6 py-3 bg-white text-black hover:bg-white/90 transition-colors rounded font-medium cursor-pointer"
      >
        Send Message
      </button>
    {% endform %}
  </div>
</div>
